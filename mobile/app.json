{
  "expo": {
    "name": "Хэлмэрч",
    "slug": "helmerch",
    "version": "1.3.0",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/8e93f55a-244b-41bb-926a-bd991a2f98f5"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "helmerch",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pulse0330.helmerch",
      "infoPlist": {
        "NSCameraUsageDescription": "Ном, дэлгэцийн зургийг авч монгол руу орчуулахад камер хэрэгтэй.",
        "NSPhotoLibraryUsageDescription": "Зургийн сангаас зураг сонгож орчуулахад хэрэгтэй."
      }
    },
    "android": {
      "package": "com.pulse0330.helmerch",
      "adaptiveIcon": {
        "backgroundColor": "#1565C0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Ном, дэлгэцийн зургийг авч монгол руу орчуулахад камер хэрэгтэй.",
          "photosPermission": "Зургийн сангаас зураг сонгож орчуулахад хэрэгтэй."
        }
      ],
      "expo-font",
      "@bacons/apple-targets"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "com.pulse0330.helmerch.action",
                  "targetName": "HelmerchTranslate"
                },
                {
                  "bundleIdentifier": "com.pulse0330.helmerch.safari",
                  "targetName": "safari"
                }
              ]
            }
          }
        },
        "projectId": "8e93f55a-244b-41bb-926a-bd991a2f98f5"
      }
    },
    "owner": "bymbaagod"
  }
}
